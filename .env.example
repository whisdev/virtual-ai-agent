# LLM Provider (openai | anthropic | ollama)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Default model per provider
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_MODEL=llama3.2

# Language (de for German market)
DEFAULT_LANG=de
